<nav class="navbar">
    <a href="/" class="navbar-brand">Rentaluxe</a>
    <ul class="navbar-nav">
        <li><a href="/cars" class="<%= currentPage === 'catalog' ? 'active' : '' %>">Каталог</a></li>
        <% if (locals.user) { %>
            <li><a href="/rentals/active" class="<%= currentPage === 'rentals' ? 'active' : '' %>">Мои аренды</a></li>
            <li><a href="/profile" class="<%= currentPage === 'profile' ? 'active' : '' %>">Профиль</a></li>
