<%- include('../partials/head', { title: title }) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* Защита тайлов от глобальных стилей */
    .leaflet-container img.leaflet-tile {
        max-width: none !important;
        max-height: none !important;
        width: 256px !important;
        height: 256px !important;
    }
    .leaflet-pane,
    .leaflet-tile,
    .leaflet-marker-icon,
    .leaflet-marker-shadow,
    .leaflet-tile-container,
    .leaflet-pane > svg,
    .leaflet-pane > canvas,
    .leaflet-zoom-box,
    .leaflet-image-layer,
    .leaflet-layer {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
    }
    /* Скрываем атрибуцию по умолчанию, чтобы не мелькал флаг */
    .leaflet-control-attribution {
        display: none;
    }
</style>

<%- include('../partials/header') %>
<div class="container" style="padding: 24px 0;">
    <h1>Наши локации</h1>
    <div class="grid" style="margin-bottom: 24px;">
        <% locations.forEach(loc => { %>
            <div class="card">
                <div class="card-title"><%= loc.name %></div>
                <div class="card-text"><%= loc.address %></div>
            </div>
        <% }) %>
    </div>
    
    <div id="map-container" style="width:100%; height:400px; position:relative; overflow:hidden;">
        <div id="map" style="width:100%; height:100%;"></div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var locations = <%- JSON.stringify(locations) %>;
            var validLocations = locations.filter(l => l.latitude != null && l.longitude != null);
            if (validLocations.length === 0) return;

            var map = L.map('map', {
                center: [validLocations[0].latitude, validLocations[0].longitude],
                zoom: 13,
                attributionControl: false // отключаем стандартный контрол атрибуции
            });

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19
            }).addTo(map);

            // Добавляем нейтральную атрибуцию вручную
            L.control.attribution({
                prefix: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var bounds = [];
            validLocations.forEach(function(loc) {
                L.marker([loc.latitude, loc.longitude]).addTo(map)
                    .bindPopup('<b>' + loc.name + '</b><br>' + loc.address);
                bounds.push([loc.latitude, loc.longitude]);
            });

            if (bounds.length > 1) {
                map.fitBounds(bounds, { padding: [30, 30] });
            }
        });
    </script>
</div>
<%- include('../partials/footer') %>