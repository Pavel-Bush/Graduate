<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<div class="container" style="padding: 24px 0;">
    <h1>Аренда #<%= rental.id %></h1>

    <div class="card" style="margin-bottom: 24px;">
        <h2><%= rental.brand %> <%= rental.model %></h2>
        <div class="car-detail__specs">
            <li><span>Гос. номер</span><span><%= rental.license_plate %></span></li>
            <li><span>Цвет</span><span><%= rental.color %></span></li>
            <li><span>Кузов</span><span><%= rental.body_type %></span></li>
            <li><span>КПП</span><span><%= rental.transmission === 'automatic' ? 'Автомат' : 'Механика' %></span></li>
            <li><span>Пункт выдачи</span><span><%= rental.location_name || '—' %></span></li>
            <li><span>Начало</span><span><%= new Date(rental.start_datetime).toLocaleString() %></span></li>
            <li><span>Окончание (план)</span><span><%= new Date(rental.end_datetime).toLocaleString() %></span></li>
            <% if (rental.actual_end_datetime) { %>
                <li><span>Фактическое завершение</span><span><%= new Date(rental.actual_end_datetime).toLocaleString() %></span></li>
            <% } %>
            <li><span>Статус</span><span><%= rental.status %></span></li>
            <li><span>Базовая стоимость</span><span><%= rental.total_price.toLocaleString('ru-RU') %> ₽</span></li>
        </div>
    </div>

    <!-- Дополнительные услуги -->
    <h2>Дополнительные услуги</h2>
    <% if (rental.services.length === 0) { %>
        <p>Нет услуг.</p>
    <% } else { %>
        <table style="width:100%; border-collapse: collapse; margin-bottom: 24px;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border);">
                    <th style="text-align: left; padding: 8px;">Услуга</th>
                    <th style="text-align: center; padding: 8px;">Количество</th>
                    <th style="text-align: right; padding: 8px;">Цена за ед.</th>
                    <th style="text-align: right; padding: 8px;">Сумма</th>
                    <th style="text-align: center; padding: 8px;">Статус</th>
                </tr>
            </thead>
            <tbody>
                <% rental.services.forEach(s => { %>
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 8px;"><%= s.name %></td>
                        <td style="text-align: center; padding: 8px;"><%= s.quantity %></td>
                        <td style="text-align: right; padding: 8px;"><%= s.unit_price.toLocaleString('ru-RU') %> ₽</td>
                        <td style="text-align: right; padding: 8px;"><%= (s.unit_price * s.quantity).toLocaleString('ru-RU') %> ₽</td>
                        <td style="text-align: center; padding: 8px;"><%= s.is_paid ? 'Оплачено' : 'Не оплачено' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

    <!-- Штрафы -->
    <h2>Штрафы</h2>
    <% if (rental.fines.length === 0) { %>
        <p>Нет штрафов.</p>
    <% } else { %>
        <table style="width:100%; border-collapse: collapse; margin-bottom: 24px;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border);">
                    <th style="text-align: left; padding: 8px;">Причина</th>
                    <th style="text-align: right; padding: 8px;">Сумма</th>
                    <th style="text-align: center; padding: 8px;">Статус</th>
                </tr>
            </thead>
            <tbody>
                <% rental.fines.forEach(fine => { %>
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 8px;"><%= fine.reason || '—' %></td>
                        <td style="text-align: right; padding: 8px;"><%= fine.amount.toLocaleString('ru-RU') %> ₽</td>
                        <td style="text-align: center; padding: 8px;"><%= fine.status === 'paid' ? 'Оплачено' : 'Не оплачено' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

    <div style="margin-top: 24px;">
        <a href="/rentals/active" class="btn-outline">Назад к арендам</a>
    </div>
</div>
<%- include('../partials/footer') %>