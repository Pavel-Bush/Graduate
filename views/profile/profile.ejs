<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<div class="container" style="padding: 24px 0;">
    <h1>Личный кабинет</h1>
    <div style="display: flex; gap: 24px; flex-wrap: wrap; margin-top: 16px;">
        
        <!-- Профиль и штрафы (левая колонка) -->
        <div style="flex: 1 1 300px;">
            <div class="card">
                <h2>Данные профиля</h2>
                <p><strong>ФИО:</strong> <%= user.full_name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
                <p><strong>Роль:</strong> <%= user.role %></p>
                <p><strong>Номер ВУ:</strong> <%= user.driver_license_number || '—' %></p>
                <p><strong>Категории:</strong> <%= user.license_categories || '—' %></p>
            </div>

            <h2 style="margin-top: 24px;">Мои штрафы</h2>
            <% if (fines.length === 0) { %>
                <p>Штрафов нет.</p>
            <% } else { %>
                <ul style="list-style: none; padding: 0;">
                    <% fines.forEach(fine => { %>
                        <li style="margin-bottom: 8px; padding: 8px; border: 1px solid var(--border); border-radius: var(--radius);">
                            <div><strong><%= fine.amount %> ₽</strong> — <%= fine.reason || 'Без причины' %></div>
                            <div style="font-size: 0.9rem; color: var(--text-secondary);">Статус: <%= fine.status %></div>
                            <% if (fine.status === 'unpaid') { %>
                                <a href="/rentals/<%= fine.rental_id %>/pay-fines" class="btn-outline" style="font-size:0.8rem; padding:4px 8px;">Оплатить</a>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <!-- Банковские карты (правая колонка) -->
        <div style="flex: 1 1 300px;">
            <div class="card">
                <h2>Банковские карты</h2>

                <%- include('../partials/alerts') %>

                <% if (cards.length === 0) { %>
                    <p>У вас нет сохранённых карт.</p>
                <% } else { %>
                    <ul style="list-style: none; padding: 0; margin-bottom: 16px;">
                        <% cards.forEach(card => { %>
                            <li style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border);">
                                <span>
                                    **** **** **** <%= card.card_last4 %>
                                    <% if (card.is_default) { %>
                                        <span style="color: var(--success); font-weight: 500;">(основная)</span>
                                    <% } %>
                                </span>
                                <span style="display: flex; gap: 8px;">
                                    <% if (!card.is_default) { %>
                                        <form action="/profile/cards/<%= card.id %>/default" method="POST" style="margin:0;">
                                            <button type="submit" class="btn-outline" style="font-size:0.8rem; padding:4px 8px;">Основная</button>
                                        </form>
                                    <% } %>
                                    <form action="/profile/cards/<%= card.id %>/delete" method="POST" style="margin:0;">
                                        <button type="submit" class="btn-outline" style="font-size:0.8rem; padding:4px 8px; color: var(--danger); border-color: var(--danger);">Удалить</button>
                                    </form>
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>

                <h3>Добавить новую карту</h3>
                <form action="/profile/cards" method="POST">
                    <div class="form-group">
                        <label for="card_number">Номер карты (16 цифр)</label>
                        <input type="text" class="form-control" id="card_number" name="card_number" placeholder="0000 0000 0000 0000" required>
                    </div>
                    <div style="display: flex; gap: 12px;">
                        <div class="form-group" style="flex: 1;">
                            <label for="expiry_month">Месяц</label>
                            <input type="number" class="form-control" id="expiry_month" name="expiry_month" min="1" max="12" placeholder="ММ" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label for="expiry_year">Год</label>
                            <input type="number" class="form-control" id="expiry_year" name="expiry_year" min="2025" placeholder="ГГГГ" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label for="cvv">CVV</label>
                            <input type="text" class="form-control" id="cvv" name="cvv" maxlength="3" placeholder="123" required>
                        </div>
                    </div>
                    <button type="submit" class="btn">Добавить</button>
                </form>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>