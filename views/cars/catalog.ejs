<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<div class="container" style="padding-top: 24px; padding-bottom: 24px;">
    <h1 style="margin-bottom: 16px;">Каталог автомобилей</h1>

    <form method="get" action="/cars" class="filters" style="flex-wrap: wrap;">
        <!-- Основные поля дат (всегда видны) -->
        <div class="form-group">
            <label for="start_date">Дата начала</label>
            <input type="date" class="form-control" id="start_date" name="start_date" value="<%= filters.start_date %>">
        </div>
        <div class="form-group">
            <label for="end_date">Дата окончания</label>
            <input type="date" class="form-control" id="end_date" name="end_date" value="<%= filters.end_date %>">
        </div>

        <!-- Расширенные фильтры (сворачиваемые) -->
        <details style="width:100%; margin: 8px 0;">
            <summary style="cursor: pointer; font-weight: 500; color: var(--accent);">Расширенные фильтры</summary>
            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px;">
                <div class="form-group">
                    <label for="brand">Бренд</label>
                    <select class="form-control" id="brand" name="brand">
                        <option value="">Все</option>
                        <option value="Бренд1" <%= filters.brand === 'Бренд1' ? 'selected' : '' %>>Бренд1</option>
                        <option value="Бренд2" <%= filters.brand === 'Бренд2' ? 'selected' : '' %>>Бренд2</option>
                        <option value="Бренд3" <%= filters.brand === 'Бренд3' ? 'selected' : '' %>>Бренд3</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="model">Модель</label>
                    <input type="text" class="form-control" id="model" name="model" value="<%= filters.model %>">
                </div>
                <div class="form-group">
                    <label for="transmission">КПП</label>
                    <select class="form-control" id="transmission" name="transmission">
                        <option value="">Все</option>
                        <option value="automatic" <%= filters.transmission === 'automatic' ? 'selected' : '' %>>Автомат</option>
                        <option value="manual" <%= filters.transmission === 'manual' ? 'selected' : '' %>>Механика</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="body_type">Кузов</label>
                    <select class="form-control" id="body_type" name="body_type">
                        <option value="">Все</option>
                        <option value="sedan" <%= filters.body_type === 'sedan' ? 'selected' : '' %>>Седан</option>
                        <option value="hatchback" <%= filters.body_type === 'hatchback' ? 'selected' : '' %>>Хэтчбек</option>
                        <option value="suv" <%= filters.body_type === 'suv' ? 'selected' : '' %>>Внедорожник</option>
                        <option value="wagon" <%= filters.body_type === 'wagon' ? 'selected' : '' %>>Универсал</option>
                        <option value="coupe" <%= filters.body_type === 'coupe' ? 'selected' : '' %>>Купе</option>
                        <option value="convertible" <%= filters.body_type === 'convertible' ? 'selected' : '' %>>Кабриолет</option>
                        <option value="minivan" <%= filters.body_type === 'minivan' ? 'selected' : '' %>>Минивэн</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="seats_min">Мин. мест</label>
                    <input type="number" class="form-control" id="seats_min" name="seats_min" min="1" value="<%= filters.seats_min %>">
                </div>
                <div class="form-group" style="align-self: center;">
                    <label><input type="checkbox" name="parking" value="1" <%= filters.parking === '1' ? 'checked' : '' %>> Парктроники</label>
                </div>
                <div class="form-group">
                    <label for="price_min">Цена от</label>
                    <input type="number" class="form-control" id="price_min" name="price_min" step="100" value="<%= filters.price_min %>">
                </div>
                <div class="form-group">
                    <label for="price_max">Цена до</label>
                    <input type="number" class="form-control" id="price_max" name="price_max" step="100" value="<%= filters.price_max %>">
                </div>
                <div class="form-group">
                    <label for="color">Цвет</label>
                    <select class="form-control" id="color" name="color">
                        <option value="">Любой</option>
                        <option value="Белый" <%= filters.color === 'Белый' ? 'selected' : '' %>>Белый</option>
                        <option value="Чёрный" <%= filters.color === 'Чёрный' ? 'selected' : '' %>>Чёрный</option>
                        <option value="Синий" <%= filters.color === 'Синий' ? 'selected' : '' %>>Синий</option>
                        <option value="Красный" <%= filters.color === 'Красный' ? 'selected' : '' %>>Красный</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="location_id">Локация</label>
                <select class="form-control" id="location_id" name="location_id">
                    <option value="">Все</option>
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc.id %>" <%= filters.location_id == loc.id ? 'selected' : '' %>><%= loc.name %></option>
                    <% }) %>
                </select>
            </div>
        </details>

    <div class="form-group" style="align-self: flex-end; display: flex; gap: 8px;">
        <button type="submit" class="btn">Показать</button>
        <a href="/cars" class="btn btn-secondary">Сбросить</a>
    </div>
    </form>

    <% if (models.length > 0) { %>
        <div class="grid">
            <% models.forEach(model => { %>
                <div class="card">
                    <img src="/images/cars/<%= model.image || 'placeholder.jpg' %>" alt="<%= model.brand %> <%= model.model %>" style="width:100%; height:180px; object-fit:cover; border-radius: 12px 12px 0 0;" onerror="this.src='/images/placeholder.png'">
                    <div style="padding: 16px;">
                        <div class="card-title"><%= model.brand %> <%= model.model %></div>
                        <div class="card-text">Кузов: <%= model.body_type %>, КПП: <%= model.transmission === 'automatic' ? 'Автомат' : 'Механика' %></div>
                        <% if (model.colors) { %>
                            <div style="display: flex; align-items: center; gap: 6px; margin: 8px 0;">
                                <% model.colors.split(',').forEach(color => { %>
                                    <span style="display:inline-block; width:16px; height:16px; border-radius:50%; background-color: <%= color.trim().toLowerCase() === 'белый' ? '#fff' : color.trim().toLowerCase() === 'чёрный' ? '#000' : color.trim().toLowerCase() === 'синий' ? '#1e3a5f' : color.trim().toLowerCase() === 'красный' ? '#c62828' : '#ccc' %>; border: 1px solid #aaa;" title="<%= color.trim() %>"></span>
                                <% }) %>
                            </div>
                        <% } %>
                        <div class="card-price"><%= model.base_price_per_day.toLocaleString('ru-RU') %> ₽ / сутки</div>
                        <a href="/cars/<%= model.id %>" class="btn" style="margin-top: 8px;">Подробнее</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p>Нет доступных автомобилей, соответствующих фильтрам.</p>
    <% } %>
</div>
<%- include('../partials/footer') %>